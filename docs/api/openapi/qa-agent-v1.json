{
  "components": {
    "schemas": {
      "AcceptanceFinding": {
        "description": "Single acceptance finding.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "check": {
            "title": "Check",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "is_blocking": {
            "default": false,
            "title": "Is Blocking",
            "type": "boolean"
          },
          "level": {
            "enum": [
              "L0",
              "L1",
              "L2"
            ],
            "title": "Level",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "severity": {
            "default": "info",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "title": "Severity",
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARN",
              "INFO",
              "SKIP"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "level",
          "category",
          "check",
          "status"
        ],
        "title": "AcceptanceFinding",
        "type": "object"
      },
      "AcceptanceSummary": {
        "description": "Acceptance summary.",
        "properties": {
          "l0_failures": {
            "default": 0,
            "minimum": 0.0,
            "title": "L0 Failures",
            "type": "integer"
          },
          "l0_gate": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR"
            ],
            "title": "L0 Gate",
            "type": "string"
          },
          "l1_check": {
            "enum": [
              "PASS",
              "WARN",
              "ERROR"
            ],
            "title": "L1 Check",
            "type": "string"
          },
          "l1_warnings": {
            "default": 0,
            "minimum": 0.0,
            "title": "L1 Warnings",
            "type": "integer"
          },
          "l2_report": {
            "const": "INFO",
            "default": "INFO",
            "title": "L2 Report",
            "type": "string"
          },
          "total_checks": {
            "default": 0,
            "minimum": 0.0,
            "title": "Total Checks",
            "type": "integer"
          }
        },
        "required": [
          "l0_gate",
          "l1_check"
        ],
        "title": "AcceptanceSummary",
        "type": "object"
      },
      "ExecutorCapabilities": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "automatic_crash_resume": {
            "const": false,
            "default": false,
            "title": "Automatic Crash Resume",
            "type": "boolean"
          },
          "business_outcome_acceptance": {
            "const": "separate_control_plane_review",
            "default": "separate_control_plane_review",
            "title": "Business Outcome Acceptance",
            "type": "string"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "cost_metering": {
            "const": "reserved_ceiling_estimate",
            "default": "reserved_ceiling_estimate",
            "title": "Cost Metering",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "idempotency": {
            "const": "owner_local_durable_request_and_receipt",
            "default": "owner_local_durable_request_and_receipt",
            "title": "Idempotency",
            "type": "string"
          },
          "input_limit_bytes": {
            "const": 1000000,
            "default": 1000000,
            "title": "Input Limit Bytes",
            "type": "integer"
          },
          "output_limit_bytes": {
            "const": 1000000,
            "default": 1000000,
            "title": "Output Limit Bytes",
            "type": "integer"
          },
          "runtime_id": {
            "title": "Runtime Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "timeout_seconds": {
            "title": "Timeout Seconds",
            "type": "integer"
          }
        },
        "required": [
          "runtime_id",
          "company_id",
          "enabled",
          "actions",
          "timeout_seconds"
        ],
        "title": "ExecutorCapabilities",
        "type": "object"
      },
      "ExecutorReceipt": {
        "additionalProperties": false,
        "properties": {
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutorResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "runtime_id": {
            "title": "Runtime Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "runtime_id",
          "company_id",
          "run_id",
          "state",
          "response"
        ],
        "title": "ExecutorReceipt",
        "type": "object"
      },
      "ExecutorResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_references": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Artifact References",
            "type": "array"
          },
          "cost_is_estimate": {
            "default": false,
            "title": "Cost Is Estimate",
            "type": "boolean"
          },
          "cost_usd": {
            "minimum": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "output": {
            "additionalProperties": true,
            "title": "Output",
            "type": "object"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "accepted",
              "recorded"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "maxLength": 20000,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "summary",
          "cost_usd"
        ],
        "title": "ExecutorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QACheckAggregate": {
        "description": "Aggregated check statistics.",
        "properties": {
          "check": {
            "title": "Check",
            "type": "string"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          }
        },
        "required": [
          "check",
          "count"
        ],
        "title": "QACheckAggregate",
        "type": "object"
      },
      "QARunDetailResponse": {
        "description": "GET /api/v1/qa/runs/{id} response body.",
        "properties": {
          "agent_name": {
            "title": "Agent Name",
            "type": "string"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "files_changed": {
            "items": {
              "type": "string"
            },
            "title": "Files Changed",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/AcceptanceFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "level": {
            "title": "Level",
            "type": "string"
          },
          "notification_summary": {
            "additionalProperties": true,
            "title": "Notification Summary",
            "type": "object"
          },
          "raw_report": {
            "additionalProperties": true,
            "title": "Raw Report",
            "type": "object"
          },
          "report_markdown": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Markdown"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/AcceptanceSummary"
          },
          "trigger": {
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "agent_name",
          "trigger",
          "level",
          "summary",
          "raw_report",
          "created_at"
        ],
        "title": "QARunDetailResponse",
        "type": "object"
      },
      "QARunListItem": {
        "description": "GET /api/v1/qa/runs list item.",
        "properties": {
          "agent_name": {
            "title": "Agent Name",
            "type": "string"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "l0_status": {
            "title": "L0 Status",
            "type": "string"
          },
          "l1_status": {
            "title": "L1 Status",
            "type": "string"
          },
          "mr_iid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mr Iid"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "total_checks": {
            "title": "Total Checks",
            "type": "integer"
          },
          "trigger": {
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "agent_name",
          "trigger",
          "l0_status",
          "l1_status",
          "total_checks",
          "duration_seconds",
          "created_at"
        ],
        "title": "QARunListItem",
        "type": "object"
      },
      "QARunListResponse": {
        "description": "GET /api/v1/qa/runs response body.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/QARunListItem"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "items"
        ],
        "title": "QARunListResponse",
        "type": "object"
      },
      "QARunTriggerRequest": {
        "description": "POST /api/v1/qa/run request body.",
        "properties": {
          "agent_name": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Agent Name",
            "type": "string"
          },
          "commit_sha": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 7,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "files_changed": {
            "items": {
              "type": "string"
            },
            "title": "Files Changed",
            "type": "array"
          },
          "gitlab_project_id": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gitlab Project Id"
          },
          "level": {
            "default": "all",
            "enum": [
              "l0",
              "l1",
              "l2",
              "all"
            ],
            "title": "Level",
            "type": "string"
          },
          "mr_iid": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mr Iid"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "requested_by": {
            "default": "api",
            "title": "Requested By",
            "type": "string"
          }
        },
        "required": [
          "agent_name"
        ],
        "title": "QARunTriggerRequest",
        "type": "object"
      },
      "QARunTriggerResponse": {
        "description": "POST /api/v1/qa/run response body.",
        "properties": {
          "agent_name": {
            "title": "Agent Name",
            "type": "string"
          },
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "number"
          },
          "level": {
            "enum": [
              "l0",
              "l1",
              "l2",
              "all"
            ],
            "title": "Level",
            "type": "string"
          },
          "notification_summary": {
            "additionalProperties": true,
            "title": "Notification Summary",
            "type": "object"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "warn",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/AcceptanceSummary"
          }
        },
        "required": [
          "run_id",
          "status",
          "agent_name",
          "level",
          "summary",
          "duration_seconds"
        ],
        "title": "QARunTriggerResponse",
        "type": "object"
      },
      "QAStatsResponse": {
        "description": "GET /api/v1/qa/stats response body.",
        "properties": {
          "agent_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Name"
          },
          "avg_duration_seconds": {
            "title": "Avg Duration Seconds",
            "type": "number"
          },
          "days": {
            "title": "Days",
            "type": "integer"
          },
          "failed_runs": {
            "title": "Failed Runs",
            "type": "integer"
          },
          "l0_fail_rate": {
            "title": "L0 Fail Rate",
            "type": "number"
          },
          "pass_runs": {
            "title": "Pass Runs",
            "type": "integer"
          },
          "top_l0_failures": {
            "items": {
              "$ref": "#/components/schemas/QACheckAggregate"
            },
            "title": "Top L0 Failures",
            "type": "array"
          },
          "top_l1_warnings": {
            "items": {
              "$ref": "#/components/schemas/QACheckAggregate"
            },
            "title": "Top L1 Warnings",
            "type": "array"
          },
          "total_runs": {
            "title": "Total Runs",
            "type": "integer"
          },
          "warn_runs": {
            "title": "Warn Runs",
            "type": "integer"
          }
        },
        "required": [
          "days",
          "total_runs",
          "pass_runs",
          "warn_runs",
          "failed_runs",
          "l0_fail_rate",
          "avg_duration_seconds"
        ],
        "title": "QAStatsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Automated acceptance verification for AI-generated code",
    "title": "QA Agent",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent/request": {
      "post": {
        "description": "Generic internal request boundary for deployed agent services.",
        "operationId": "agent_request_agent_request_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Agent Request",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/executor/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_executor_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorCapabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Capabilities",
        "tags": [
          "executor"
        ]
      }
    },
    "/api/v1/executor/requests": {
      "post": {
        "operationId": "execute_api_v1_executor_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Action",
                    "type": "string"
                  },
                  "agent_id": {
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Agent Id",
                    "type": "string"
                  },
                  "company_id": {
                    "maxLength": 48,
                    "minLength": 1,
                    "title": "Company Id",
                    "type": "string"
                  },
                  "goal_id": {
                    "anyOf": [
                      {
                        "maxLength": 48,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Goal Id"
                  },
                  "input": {
                    "additionalProperties": true,
                    "title": "Input",
                    "type": "object"
                  },
                  "max_cost_usd": {
                    "maximum": 1000000.0,
                    "minimum": 0.0,
                    "title": "Max Cost Usd",
                    "type": "number"
                  },
                  "run_id": {
                    "maxLength": 48,
                    "minLength": 1,
                    "title": "Run Id",
                    "type": "string"
                  },
                  "schema_version": {
                    "const": "1.0",
                    "title": "Schema Version",
                    "type": "string"
                  },
                  "trace_id": {
                    "anyOf": [
                      {
                        "maxLength": 96,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Trace Id"
                  },
                  "work_item_id": {
                    "anyOf": [
                      {
                        "maxLength": 48,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Work Item Id"
                  }
                },
                "required": [
                  "schema_version",
                  "company_id",
                  "action",
                  "agent_id",
                  "run_id",
                  "input",
                  "max_cost_usd"
                ],
                "title": "ExecutorRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Execute",
        "tags": [
          "executor"
        ]
      }
    },
    "/api/v1/executor/requests/{run_id}": {
      "get": {
        "operationId": "receipt_api_v1_executor_requests__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "company_id",
            "required": true,
            "schema": {
              "title": "Company Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receipt",
        "tags": [
          "executor"
        ]
      }
    },
    "/api/v1/qa/run": {
      "post": {
        "description": "Trigger a QA acceptance run manually.",
        "operationId": "trigger_run_api_v1_qa_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QARunTriggerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QARunTriggerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trigger Run",
        "tags": [
          "qa"
        ]
