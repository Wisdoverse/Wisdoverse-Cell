          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "task": {
            "default": "",
            "title": "Task",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "severity"
        ],
        "title": "AlertItem",
        "type": "object"
      },
      "AlertListResponse": {
        "properties": {
          "alerts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/AlertItem"
            },
            "title": "Alerts",
            "type": "array"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "title": "AlertListResponse",
        "type": "object"
      },
      "ConfigRefreshResponse": {
        "properties": {
          "status": {
            "default": "refreshed",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ConfigRefreshResponse",
        "type": "object"
      },
      "DecomposeActionRequest": {
        "properties": {
          "operator": {
            "default": "",
            "title": "Operator",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "DecomposeActionRequest",
        "type": "object"
      },
      "DecomposeActionResponse": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "story_count": {
            "default": 0,
            "title": "Story Count",
            "type": "integer"
          },
          "subject": {
            "default": "",
            "title": "Subject",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "task_count": {
            "default": 0,
            "title": "Task Count",
            "type": "integer"
          },
          "wp_id": {
            "title": "Wp Id",
            "type": "integer"
          }
        },
        "required": [
          "success",
          "wp_id",
          "action"
        ],
        "title": "DecomposeActionResponse",
        "type": "object"
      },
      "DecomposeStatusResponse": {
        "properties": {
          "approved_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved By"
          },
          "assignee_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
