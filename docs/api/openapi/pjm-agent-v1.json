    "/api/v1/executor/requests": {
      "post": {
        "operationId": "execute_api_v1_executor_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Action",
                    "type": "string"
                  },
                  "agent_id": {
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Agent Id",
                    "type": "string"
                  },
                  "company_id": {
                    "maxLength": 48,
                    "minLength": 1,
                    "title": "Company Id",
                    "type": "string"
                  },
                  "goal_id": {
                    "anyOf": [
                      {
                        "maxLength": 48,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Goal Id"
                  },
                  "input": {
                    "additionalProperties": true,
                    "title": "Input",
                    "type": "object"
                  },
                  "max_cost_usd": {
                    "maximum": 1000000.0,
                    "minimum": 0.0,
                    "title": "Max Cost Usd",
                    "type": "number"
                  },
                  "run_id": {
                    "maxLength": 48,
                    "minLength": 1,
                    "title": "Run Id",
                    "type": "string"
                  },
                  "schema_version": {
                    "const": "1.0",
                    "title": "Schema Version",
                    "type": "string"
                  },
                  "trace_id": {
                    "anyOf": [
                      {
                        "maxLength": 96,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Trace Id"
                  },
                  "work_item_id": {
                    "anyOf": [
                      {
                        "maxLength": 48,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Work Item Id"
                  }
                },
                "required": [
                  "schema_version",
                  "company_id",
                  "action",
                  "agent_id",
                  "run_id",
                  "input",
                  "max_cost_usd"
                ],
                "title": "ExecutorRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutorResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Execute",
        "tags": [
          "executor"
        ]
      }
    },
