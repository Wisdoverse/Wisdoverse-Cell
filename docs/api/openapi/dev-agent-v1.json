{
  "components": {
    "schemas": {
      "ApproveWorkflowRequest": {
        "properties": {
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "operator": {
            "default": "",
            "title": "Operator",
            "type": "string"
          }
        },
        "title": "ApproveWorkflowRequest",
        "type": "object"
      },
      "ExecutorCapabilities": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "automatic_crash_resume": {
            "const": false,
            "default": false,
            "title": "Automatic Crash Resume",
            "type": "boolean"
          },
          "business_outcome_acceptance": {
            "const": "separate_control_plane_review",
            "default": "separate_control_plane_review",
            "title": "Business Outcome Acceptance",
            "type": "string"
          },
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "cost_metering": {
            "const": "reserved_ceiling_estimate",
            "default": "reserved_ceiling_estimate",
            "title": "Cost Metering",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "idempotency": {
            "const": "owner_local_durable_request_and_receipt",
            "default": "owner_local_durable_request_and_receipt",
            "title": "Idempotency",
            "type": "string"
          },
          "input_limit_bytes": {
            "const": 1000000,
            "default": 1000000,
            "title": "Input Limit Bytes",
            "type": "integer"
          },
          "output_limit_bytes": {
            "const": 1000000,
            "default": 1000000,
            "title": "Output Limit Bytes",
            "type": "integer"
          },
          "runtime_id": {
            "title": "Runtime Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "timeout_seconds": {
            "title": "Timeout Seconds",
            "type": "integer"
          }
        },
        "required": [
          "runtime_id",
          "company_id",
          "enabled",
          "actions",
          "timeout_seconds"
        ],
        "title": "ExecutorCapabilities",
        "type": "object"
      },
      "ExecutorReceipt": {
        "additionalProperties": false,
        "properties": {
          "company_id": {
            "title": "Company Id",
            "type": "string"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutorResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "runtime_id": {
            "title": "Runtime Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "runtime_id",
          "company_id",
          "run_id",
          "state",
          "response"
        ],
        "title": "ExecutorReceipt",
        "type": "object"
      },
      "ExecutorResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_references": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Artifact References",
            "type": "array"
          },
          "cost_is_estimate": {
            "default": false,
            "title": "Cost Is Estimate",
            "type": "boolean"
          },
          "cost_usd": {
            "minimum": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "output": {
            "additionalProperties": true,
            "title": "Output",
            "type": "object"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "accepted",
              "recorded"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "maxLength": 20000,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "summary",
          "cost_usd"
        ],
        "title": "ExecutorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
